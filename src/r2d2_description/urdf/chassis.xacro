<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================
       base_footprint — Boden-Ebene direkt unter dem Roboter.
       Nav2-Standard: odom → base_footprint → base_link
       ============================================================ -->
  <link name="base_footprint"/>

  <!-- ============================================================
       base_link — Roboter-Zentrum, auf Rad-Achsen-Höhe.
       Odometrie (/r2d2/chassis/odom) referenziert diesen Frame.
       ============================================================ -->
  <link name="base_link"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================
       Chassis-Hauptkörper (Zylinder, weiß)
       ============================================================ -->
  <link name="chassis_link">
    <visual>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${chassis_radius}" length="${chassis_height}"/>
        <!-- <mesh filename="package://r2d2_description/meshes/chassis.stl"/> -->
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${chassis_radius}" length="${chassis_height}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertial mass="5.0" radius="${chassis_radius}" length="${chassis_height}">
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
    </xacro:cylinder_inertial>
  </link>

  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================
       Räder (continuous joint, direkt an base_link)
       Encoder kommen vom Chassis-ESP32 via /r2d2/chassis/odom.
       ============================================================ -->
  <xacro:macro name="wheel" params="prefix side">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
          <!-- <mesh filename="package://r2d2_description/meshes/wheel.stl"/> -->
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertial mass="0.3" radius="${wheel_radius}" length="${wheel_width}">
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      </xacro:cylinder_inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="0 ${side*wheelbase/2} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="left"  side="1"/>
  <xacro:wheel prefix="right" side="-1"/>

  <!-- ============================================================
       Side-Legs: visuelle Repräsentation der klassischen R2D2-Beine.
       Rein visuell/collision — Räder hängen an base_link, nicht an Legs.
       ============================================================ -->
  <xacro:macro name="leg" params="prefix side">
    <link name="${prefix}_leg_link">
      <visual>
        <origin xyz="0 0 ${leg_length/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${leg_depth} ${leg_width} ${leg_length}"/>
          <!-- <mesh filename="package://r2d2_description/meshes/leg.stl"/> -->
        </geometry>
        <material name="silver"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${leg_length/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${leg_depth} ${leg_width} ${leg_length}"/>
        </geometry>
      </collision>
      <xacro:box_inertial mass="0.8" x="${leg_depth}" y="${leg_width}" z="${leg_length}">
        <origin xyz="0 0 ${leg_length/2}" rpy="0 0 0"/>
      </xacro:box_inertial>
    </link>

    <joint name="${prefix}_leg_joint" type="fixed">
      <parent link="chassis_link"/>
      <child link="${prefix}_leg_link"/>
      <origin xyz="0 ${side*(chassis_radius+leg_width/2-0.02)} 0" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:leg prefix="left"  side="1"/>
  <xacro:leg prefix="right" side="-1"/>

</robot>
