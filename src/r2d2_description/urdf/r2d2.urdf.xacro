<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="r2d2">

  <!-- ============================================================
       R2D2 URDF — ~75cm Differential-Drive-Roboter
       Koordinaten: REP-103 (x=vorn, y=links, z=oben)
       TF-Wurzel: base_footprint
       Odometrie: /r2d2/chassis/odom (odom → base_footprint)
       ============================================================ -->

  <!-- Chassis -->
  <xacro:property name="chassis_radius" value="0.19"/>   <!-- 38cm Durchmesser -->
  <xacro:property name="chassis_height" value="0.45"/>   <!-- TODO: verify -->

  <!-- Räder (aus esp32/r2d2_chassis_esp32/src/md25.cpp) -->
  <xacro:property name="wheel_radius"   value="0.05"/>   <!-- 100mm Raddurchmesser -->
  <xacro:property name="wheel_width"    value="0.026"/>
  <xacro:property name="wheelbase"      value="0.30"/>   <!-- Spurbreite -->

  <!-- Legs (visuell) -->
  <xacro:property name="leg_length"     value="0.30"/>   <!-- TODO: verify -->
  <xacro:property name="leg_width"      value="0.08"/>
  <xacro:property name="leg_depth"      value="0.04"/>

  <!-- Dome -->
  <xacro:property name="dome_radius"    value="0.15"/>   <!-- TODO: verify -->
  <xacro:property name="dome_height"    value="0.22"/>
  <xacro:property name="neck_height"    value="0.03"/>
  <xacro:property name="dome_limit"     value="1.745"/>  <!-- ±100° aus IDENTITY.md -->

  <xacro:include filename="$(find r2d2_description)/urdf/common.xacro"/>
  <xacro:include filename="$(find r2d2_description)/urdf/chassis.xacro"/>
  <xacro:include filename="$(find r2d2_description)/urdf/dome.xacro"/>
  <xacro:include filename="$(find r2d2_description)/urdf/sensors.xacro"/>

</robot>
